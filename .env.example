# Database (PostgreSQL 18)
POSTGRES_DB=clms_db
POSTGRES_USER=clms_user
POSTGRES_PASSWORD=CLMS!
DATABASE_URL=postgresql+psycopg://clms_user:CLMS!@localhost:5432/clms_db

# Security & Auth
JWT_SECRET=replace_with_a_long_random_secret_string_at_least_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
ALLOWED_EMAIL_DOMAIN=slu.edu.ph

# Break-glass TRIL Admin seed
SEED_ADMIN_EMAIL=tril.admin@slu.edu.ph
SEED_ADMIN_PASSWORD=ChangeMe123!

# Super Admin seed
SUPER_ADMIN_EMAIL=super.admin@tril-slu.local
SUPER_ADMIN_PASSWORD=ChangeMe123!

# CORS / Frontend
FRONTEND_ORIGIN=http://localhost:5173

# Optional SMTP for forgot-password emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true